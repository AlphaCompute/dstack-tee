FROM ubuntu:24.04@sha256:3afff29dffbc200d202546dc6c4f614edc3b109691e7ab4aa23d02b42ba86790

# Prevent timezone prompt by setting noninteractive frontend and configuring tzdata
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    TZDATA=Etc/UTC \
    LC_ALL=en_US.UTF-8 \
    LANG=en_US.UTF-8

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# aws/NitroTPM-Tools v1.1.2. This binary contributes release measurements, so
# pin the source revision rather than following the repository default branch.
ARG NITRO_TPM_TOOLS_REV=d76d6eeebd4169b00a3c3af9858852d48f40e748

# Set timezone
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install required packages
RUN apt update && apt install -y \
    build-essential \
    chrpath \
    diffstat \
    lz4 \
    wireguard-tools \
    python3 \
    locales \
    ca-certificates \
    curl \
    git \
    jq \
    file \
    gawk \
    wget \
    libclang-dev \
    xorriso \
    cpio \
    zstd \
    gdisk \
    dosfstools \
    mtools \
    libsqlite3-dev

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal --default-toolchain 1.92 && \
    rustup component add rustfmt clippy rust-analyzer && \
    rustup target add wasm32-unknown-unknown x86_64-unknown-linux-musl thumbv6m-none-eabi && \
    cargo install --git https://github.com/aws/NitroTPM-Tools \
      --rev "$NITRO_TPM_TOOLS_REV" --locked nitro-tpm-pcr-compute && \
    chmod -R a+rX "$RUSTUP_HOME" "$CARGO_HOME" && \
    cargo --version && \
    rustc --version

# The image runs as the caller's uid, so keep Cargo's registry/cache writable.
ENV CARGO_HOME=/tmp/cargo

# Generate locale for bitbake
RUN locale-gen en_US.UTF-8

# Poky's usrmerge layout gives target binaries the ELF interpreter
# /usr/lib/ld-linux-x86-64.so.2; on Ubuntu the loader is at
# /lib/x86_64-linux-gnu/ (with only a /lib64 compatibility symlink), so that
# path does not resolve here. Cargo build scripts that cross-compile a probe
# with the target toolchain and then run it on the build host therefore see
# ENOENT before main(). aws-lc-sys -- reached via dcap-qvl -> reqwest ->
# rustls -- does exactly this in its memcmp check, and reports the resulting
# exit 127 as "COMPILER BUG DETECTED", failing dstack-guest do_compile.
# This link only affects probes executed on the build host; the guest
# binaries keep their own interpreter and are byte-for-byte unaffected.
RUN ln -sf /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /usr/lib/ld-linux-x86-64.so.2
